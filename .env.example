# Copy to .env and fill in. .env is git-ignored and must never be committed:
# this repository is public.
PGDATABASE=dataingest
PGUSER=dataingest
PGPASSWORD=change-me
PGPORT=5433

# Required by the fred-macro source only. https://fredaccount.stlouisfed.org
FRED_API_KEY=
# Optional: comma-separated series ids, overriding the source's defaults.
FRED_SERIES=

LOG_LEVEL=INFO
