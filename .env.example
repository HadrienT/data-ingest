# Copy to .env and fill in. .env is git-ignored and must never be committed:
# this repository is public.
PGDATABASE=dataingest
PGUSER=dataingest
PGPASSWORD=change-me
PGPORT=5433

# Required by the fred-macro and fx-rates sources. https://fredaccount.stlouisfed.org
FRED_API_KEY=
# Optional: comma-separated series ids / tickers, overriding each source's defaults.
FRED_SERIES=
FX_SERIES=
OPTIONS_CHAIN_TICKERS=

LOG_LEVEL=INFO

# Airflow (scheduling; see README's Scheduling section).
# Host user id, so files Airflow writes into the bind-mounted
# ./airflow/{logs,plugins,config} aren't owned by root. Use `id -u`.
AIRFLOW_UID=50000
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# openssl rand -hex 32
AIRFLOW_JWT_SECRET=
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=change-me
