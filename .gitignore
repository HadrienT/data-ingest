# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*-key.json
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/
.pytest_cache/

# Data pulled down locally; never in git
/data/
/data/**/*.parquet
*.csv.gz

# Airflow runtime state, bind-mounted by docker-compose; only airflow/dags/
# is source and belongs in git.
/airflow/logs/
/airflow/plugins/
/airflow/config/
